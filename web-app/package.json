  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "@capacitor/cli": "^8.6.0",
    "vite": "^5.4.11",
    "concurrently": "^9.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
