    "cors": "^2.8.5",
    "drizzle-orm": "^1.0.0-beta.22",
    "express": "^4.21.1",
    "node-cron": "^3.0.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.1.0",
    "drizzle-kit": "^1.0.0-beta.22",
